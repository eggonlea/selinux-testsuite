/run:
  summary: Run the testsuite
  discover:
    how: fmf
    filter: tag:-ci
  execute:
    how: tmt
  provision:
    how: virtual
    hardware:
      cpu:
        processors: 32
    memory: 16 GB
    disk: 100 GB
/run-ci:
  summary: Run the CI for the testsuite
  tag: [ci]
  discover:
    how: fmf
  execute:
    how: tmt
